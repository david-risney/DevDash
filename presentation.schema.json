{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/david-risney/DevDash/presentation.schema.json",
  "title": "DevDash user presentation configuration",
  "type": "object",
  "required": ["version", "presentation"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "presentation": { "$ref": "#/definitions/presentation" }
  },
  "definitions": {
    "color": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}|p:[A-Za-z][A-Za-z0-9_-]{0,63})$" },
    "style": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "foreground": { "$ref": "#/definitions/color" },
        "background": { "$ref": "#/definitions/color" },
        "bold": { "type": "boolean" }
      }
    },
    "columns": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "item": { "$ref": "#/definitions/style" },
        "title": { "$ref": "#/definitions/style" },
        "status": { "$ref": "#/definitions/style" },
        "person": { "$ref": "#/definitions/style" },
        "repository": { "$ref": "#/definitions/style" },
        "priority": { "$ref": "#/definitions/style" },
        "severity": { "$ref": "#/definitions/style" },
        "updated": { "$ref": "#/definitions/style" }
      }
    },
    "glyph": { "type": "string", "maxLength": 16 },
    "rule": {
      "anyOf": [
        { "const": false },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "left": { "$ref": "#/definitions/glyph" },
            "fill": { "$ref": "#/definitions/glyph" },
            "right": { "$ref": "#/definitions/glyph" }
          }
        }
      ]
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ansi": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "palette": {
              "type": "object", "maxProperties": 128, "additionalProperties": false,
              "patternProperties": {
                "^[A-Za-z][A-Za-z0-9_-]{0,63}$": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            },
            "links": { "type": "boolean" },
            "icons": { "type": "boolean" },
            "glyphs": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "dashboard": { "$ref": "#/definitions/glyph" },
                "warning": { "$ref": "#/definitions/glyph" },
                "pr": { "$ref": "#/definitions/glyph" },
                "cl": { "$ref": "#/definitions/glyph" },
                "bugs": {
                  "type": "array", "minItems": 1, "maxItems": 32,
                  "items": { "$ref": "#/definitions/glyph" }
                }
              }
            },
            "table": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "caps": { "type": "boolean" },
                "cornerStyle": { "enum": ["half", "quarter", "semicircle"] },
                "padding": { "type": "integer", "minimum": 0, "maximum": 3 },
                "gap": { "type": "integer", "minimum": 0, "maximum": 6 },
                "separator": { "type": "string", "maxLength": 16 },
                "border": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "left": { "$ref": "#/definitions/glyph" },
                    "right": { "$ref": "#/definitions/glyph" },
                    "titleLeft": { "$ref": "#/definitions/glyph" },
                    "titleRight": { "$ref": "#/definitions/glyph" },
                    "lastLeft": { "$ref": "#/definitions/glyph" },
                    "lastRight": { "$ref": "#/definitions/glyph" },
                    "top": { "$ref": "#/definitions/rule" },
                    "bottom": { "$ref": "#/definitions/rule" },
                    "filledSides": { "type": "boolean" },
                    "colorSource": { "enum": ["header", "row"] },
                    "foreground": { "$ref": "#/definitions/color" }
                  }
                },
                "header": { "$ref": "#/definitions/style" },
                "rows": {
                  "type": "array", "minItems": 1, "maxItems": 8,
                  "items": { "$ref": "#/definitions/style" }
                },
                "columns": { "$ref": "#/definitions/columns" },
                "states": {
                  "type": "object", "additionalProperties": false,
                  "properties": {
                    "active": { "$ref": "#/definitions/style" },
                    "closed": { "$ref": "#/definitions/style" },
                    "draft": { "$ref": "#/definitions/style" }
                  }
                },
                "missing": { "$ref": "#/definitions/style" },
                "warning": { "$ref": "#/definitions/style" },
                "error": { "$ref": "#/definitions/style" }
              }
            }
          }
        },
        "ascii": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "links": { "type": "boolean" },
            "table": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "separator": { "type": "string", "minLength": 1, "maxLength": 3, "pattern": "^[\\x20-\\x7e]+$" },
                "junction": { "type": "string", "minLength": 1, "maxLength": 3, "pattern": "^[\\x20-\\x7e]+$" }
              }
            }
          }
        },
        "md": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "links": { "type": "boolean" },
            "headingLevel": { "type": "integer", "minimum": 2, "maximum": 6 },
            "table": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "align": {
                  "type": "object", "additionalProperties": false,
                  "patternProperties": {
                    "^(item|title|status|person|repository|priority|severity|updated)$": { "enum": ["left", "center", "right"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
